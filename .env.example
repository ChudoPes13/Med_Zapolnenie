MEDJARVIS_GPU_REQUIRED=1
MEDJARVIS_DATABASE_URL=sqlite:///data/medjarvis.db
MEDJARVIS_LLAMA_SERVER_URL=http://127.0.0.1:8080/v1
MEDJARVIS_LLAMA_MODEL=qwen3-4b-q4-k-m
MEDJARVIS_REQUIRE_LLM=0
MEDJARVIS_ASR_MODEL=large-v3-turbo
MEDJARVIS_ASR_LANGUAGE=ru
MEDJARVIS_ASR_COMPUTE_TYPE=int8_float16
MEDJARVIS_EXPORT_DIR=exports
